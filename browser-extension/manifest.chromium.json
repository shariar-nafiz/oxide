{
  "manifest_version": 3,
  "name": "Oxide Download Manager",
  "version": "0.1.0",
  "description": "Blazing-fast multi-segment dynamic download manager integration for Oxide",
  "permissions": [
    "downloads",
    "webRequest",
    "webRequestAuthProvider",
    "nativeMessaging",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Oxide"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
